# Public origin. Production must use HTTPS and match the OAuth redirect origin.
ATPROTO_ACL_ORIGIN=https://acl.example.com
ATPROTO_ACL_PORT=8426

# Persistent, owner-only application state.
ATPROTO_ACL_DATA_DIR=/srv/atproto-acl/state
ATPROTO_ACL_PYTHON=/srv/atproto-acl/venv/bin/python

# Generate these with: node web/scripts/generate-secrets.mjs /secure/path
ATPROTO_ACL_OAUTH_KEY_FILE=/secure/path/oauth-signing-key.jwk
ATPROTO_ACL_SESSION_SECRET_FILE=/secure/path/session-secret
ATPROTO_ACL_TOMBSTONE_SECRET_FILE=/secure/path/tombstone-secret

# Keep deletion tombstones outside ordinary application backups.
ATPROTO_ACL_TOMBSTONE_PATH=/srv/atproto-acl-deletions/deletions.db

# Optional comma-separated pilot allowlist. Leave empty only for an intentionally
# open deployment with the application's admission controls configured.
ATPROTO_ACL_ALLOWED_DIDS=did:plc:replace-with-authorized-account
ATPROTO_ACL_ADMISSION_MODE=allowlist

# Conservative beta capacity defaults. Tune deliberately for the host.
ATPROTO_ACL_ACQUISITION_STARTS_PER_DID_HOUR=6
ATPROTO_ACL_ACQUISITION_STARTS_GLOBAL_HOUR=20
ATPROTO_ACL_ACQUISITION_CONCURRENCY_GLOBAL=2
ATPROTO_ACL_ACQUISITION_CONCURRENCY_PER_DID=1
ATPROTO_ACL_ACQUISITION_QUEUE_DEPTH=10
ATPROTO_ACL_ACQUISITION_MAX_WAIT_SECONDS=600
ATPROTO_ACL_ACTION_BATCH_MAX=50
ATPROTO_ACL_EFFECTS_PER_DID_DAY=100
ATPROTO_ACL_EFFECTS_GLOBAL_DAY=250
ATPROTO_ACL_QUEUED_ACTIONS_GLOBAL=500

# Run the web and action worker as separate processes in production.
ATPROTO_ACL_WORKER=0
