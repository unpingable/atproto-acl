ATPROTO_ACL_ORIGIN=https://acl.example.com
ATPROTO_ACL_PORT=8426
ATPROTO_ACL_DATA_DIR=/srv/atproto-acl/state
ATPROTO_ACL_PYTHON=/opt/atproto-acl/current/venv/bin/python
ATPROTO_ACL_ALLOWED_DIDS=did:plc:replace-with-authorized-account
ATPROTO_ACL_ADMISSION_MODE=allowlist
ATPROTO_ACL_TOMBSTONE_PATH=/srv/atproto-acl-deletions/deletions.db
ATPROTO_ACL_ACQUISITION_STARTS_PER_DID_HOUR=6
ATPROTO_ACL_ACQUISITION_STARTS_GLOBAL_HOUR=20
ATPROTO_ACL_ACQUISITION_CONCURRENCY_GLOBAL=2
ATPROTO_ACL_ACQUISITION_CONCURRENCY_PER_DID=1
ATPROTO_ACL_ACQUISITION_QUEUE_DEPTH=10
ATPROTO_ACL_ACQUISITION_MAX_WAIT_SECONDS=600
ATPROTO_ACL_ACTION_BATCH_MAX=50
ATPROTO_ACL_EFFECTS_PER_DID_DAY=100
ATPROTO_ACL_EFFECTS_GLOBAL_DAY=250
ATPROTO_ACL_QUEUED_ACTIONS_GLOBAL=500
ATPROTO_ACL_BRIDGE_CONCURRENCY_GLOBAL=4
ATPROTO_ACL_BRIDGE_CONCURRENCY_PER_DID=1
ATPROTO_ACL_BRIDGE_QUEUE_DEPTH=32
