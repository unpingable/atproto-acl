[Unit]
Description=Evaluate personal ATProto attention policy
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
UMask=0077
EnvironmentFile=%h/.config/atproto-acl/credentials.env
ExecStart=%h/atproto-acl/.venv/bin/atproto-acl preview --policy %h/.config/atproto-acl/policy.yaml --authenticate
NoNewPrivileges=true
PrivateTmp=true
